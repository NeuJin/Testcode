::uplevel #0 {
    set ::probe_out "D:/femfat_probe/femfat_probe2.txt"
    if {[::catch {::source "D:/femfat_probe/femfat_probe2.tcl"} ::probe_err]} {
        set ::ef [::open "D:/femfat_probe/probe_err.txt" w]
        ::puts $::ef $::probe_err
        ::puts $::ef $::errorInfo
        ::close $::ef
    }
}
