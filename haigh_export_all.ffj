# ======================================================================
# haigh_export_all.ffj  --  FEMFAT 2024.1: xuat anh Local Haigh Diagram (full winop)
# CACH DUNG: mo FEMFAT -> vao Output module -> nap fps -> (vao trang Visualization)
#            -> File > Append... -> chon file nay. Khong can thao tac gi them.
# Quy tac co dinh: Critical Point (cham do) luon BAT; luon xuat anh FULL (winop).
# Danh sach node: tu dong lay tu fps (xem hx_discovery trong hx_log.txt);
# neu khong lay duoc, dien tay vao ::hx_nodes_manual.
# ======================================================================
::uplevel #0 {
# ---------------- TUY CHON (co the sua) ----------------
set ::hx_nodes_manual {}       ;# de trong = tu lay tu fps; hoac dien tay vi du {1397615 1205731}
set ::hx_dir_override ""       ;# de trong = tao thu muc "out" canh file fps
set ::hx_dir_fallback "D:/femfat_probe/haigh_out"
set ::hx_max_nodes 500         ;# gioi han an toan khi duyet node
# ---------------- co dinh theo quy tac ----------------
set ::hx_crit_on 1
set ::hx_hide_when_off 0
set ::hx_do_graph 0
set ::hx_do_full 1
set ::hx_tries 0
set ::hx_fh ""
set ::hx_prefix "haigh"
set ::hx_dir ""
set ::hx_nodes {}
set ::hx_btn ".femfat.hpane.rpane.main_sw.cv.dialogFr.bas-vi.inf.lf1.btHaigh.button"
set ::hx_wait 0

proc ::hx_log {s} { if {$::hx_fh ne ""} { ::catch {::puts $::hx_fh $s; ::flush $::hx_fh} } }

# ---------- chup anh ----------
proc ::hx_snap_graph {file} {
    ::catch {::image delete hx_img1}
    ::image create photo hx_img1
    .resultHaighDiagramDialog.childsite.lf1.graph.graph snap hx_img1
    hx_img1 write $file -format png
    ::image delete hx_img1
}
proc ::hx_snap_full {file} {
    if {[::info commands ::blt::winop] eq ""} { error "khong co ::blt::winop" }
    ::catch {::image delete hx_img3}
    ::image create photo hx_img3
    ::blt::winop snap .resultHaighDiagramDialog.childsite hx_img3
    hx_img3 write $file -format png
    ::image delete hx_img3
}

# ---------- legend / Critical Point ----------
proc ::hx_legend_text {} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    set txt ""
    foreach lb {lb1 lb2 lb3 lb4} { ::catch {append txt " | [$cv.$lb cget -text]"} }
    return $txt
}
proc ::hx_wait_legend {pat {maxms 5000}} {
    set t 0
    while {$t <= $maxms} {
        ::update
        if {[::string first $pat [::hx_legend_text]] >= 0} { return 1 }
        ::after 100
        incr t 100
    }
    return 0
}
proc ::hx_crit_row {} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    foreach i {1 2 3 4} {
        if {[::catch {$cv.lb$i cget -text} t]} continue
        if {[::string match -nocase "*critical*" $t]} { return $i }
    }
    return 0
}
proc ::hx_crit_on {k} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    if {[::catch {
        set a [$cv.lb$k cget -background]
        set b [$cv cget -background]
    }]} { return 0 }
    return [expr {$a ne $b}]
}
proc ::hx_click {w} {
    ::catch {::event generate $w <Enter>}
    ::event generate $w <ButtonPress-1> -x 3 -y 3
    ::event generate $w <ButtonRelease-1> -x 3 -y 3
    ::update
}
proc ::hx_set_crit {want} {
    set d .resultHaighDiagramDialog.childsite.lf1.legend
    set k [::hx_crit_row]
    if {$k == 0} { ::hx_log "crit: khong thay hang Critical trong legend"; return 0 }
    set cur [::hx_crit_on $k]
    if {$cur == $want} { return 1 }
    foreach w [list $d.cv.lb$k $d.cv.leg$k] {
        ::catch {::hx_click $w} msg
        if {[::hx_crit_on $k] == $want} { return 1 }
    }
    foreach arg [list {} $k] {
        set rc [::catch {$d toggleHighlightGraph {*}$arg} msg]
        ::update
        if {$rc == 0 && [::hx_crit_on $k] == $want} { return 1 }
    }
    return 0
}
proc ::hx_crit_elements {} {
    set g .resultHaighDiagramDialog.childsite.lf1.graph.graph
    set res {}
    foreach el [$g element names] {
        if {[::catch {$g element cget $el -label} lab]} continue
        if {[::string match -nocase "*critical*" $lab]} { lappend res $el }
    }
    return $res
}
proc ::hx_force_big {} {
    set g .resultHaighDiagramDialog.childsite.lf1.graph.graph
    foreach el [::hx_crit_elements] {
        ::catch {
            set px [$g element cget $el -pixels]
            $g element configure $el -pixels [expr {$px < 14 ? 14 : $px}]
        }
    }
}
proc ::hx_apply_crit {} {
    set g .resultHaighDiagramDialog.childsite.lf1.graph.graph
    if {$::hx_crit_on} {
        set ok [::hx_set_crit 1]
        foreach el [::hx_crit_elements] { ::catch {$g element configure $el -hide no} }
        if {!$ok} {
            ::hx_log "crit: khong bat duoc bang GUI -> phong to ky hieu truc tiep"
            ::hx_force_big
        }
    } else {
        ::hx_set_crit 0
        if {$::hx_hide_when_off} {
            foreach el [::hx_crit_elements] { ::catch {$g element configure $el -hide yes} }
        }
    }
    ::update
}

# ---------- tung node ----------
proc ::hx_one {node} {
    set d .resultHaighDiagramDialog
    set si $d.childsite.nodeSelector.si01
    ::hx_log "---- node $node ----"
    ::catch {$si.entry delete 0 end}
    ::catch {$si.entry insert 0 $node}
    set rc [::catch {$si apply} msg]
    ::hx_log "spinbox apply rc=$rc msg=$msg"
    if {![::hx_wait_legend "N$node" 6000]} {
        ::hx_log "RESULT\t$node\tFAIL\t-\t-\tnode khong co trong DETAILED RESULTS hoac do thi khong doi"
        return
    }
    ::hx_apply_crit
    ::update
    ::catch {::raise $d}
    ::update
    set gfile "-"
    set ffile "-"
    set err ""
    if {$::hx_do_graph} {
        set f [::file join $::hx_dir "${::hx_prefix}_N${node}_graph.png"]
        if {[::catch {::hx_snap_graph $f} msg]} { append err " graph:$msg" } else { set gfile $f }
    }
    if {$::hx_do_full} {
        set f [::file join $::hx_dir "${::hx_prefix}_N${node}_full.png"]
        if {[::catch {::hx_snap_full $f} msg]} { append err " full:$msg" } else { set ffile $f }
    }
    if {$err eq ""} {
        ::hx_log "RESULT\t$node\tOK\t$gfile\t$ffile\t"
    } else {
        ::hx_log "RESULT\t$node\tFAIL\t$gfile\t$ffile\t[::string trim $err]"
    }
}


# ---------- lay danh sach node tu fps ----------
proc ::hx_as_nodes {val} {
    set out {}
    if {[::catch {::llength $val}]} { return {} }
    foreach t $val {
        if {![::regexp {^[0-9]{3,9}$} $t]} { return {} }
        lappend out $t
    }
    return $out
}
# cach 1: bien cua doc0 co ten chua "node" va gia tri la danh sach so
proc ::hx_nodes_from_vars {} {
    set names {}
    ::catch {set names [::doc0 info variable]}
    ::hx_log "discovery: doc0 co [::llength $names] bien"
    set best {}
    set bestname ""
    foreach v $names {
        if {![::regexp -nocase {node} $v]} continue
        if {[::catch {::doc0 info variable $v -value} val]} continue
        ::hx_log "discovery: var $v = [::string range $val 0 160]"
        set nums [::hx_as_nodes $val]
        if {[::llength $nums] > [::llength $best]} { set best $nums; set bestname $v }
    }
    if {[::llength $best] > 0} { ::hx_log "discovery: chon bien $bestname ([::llength $best] node)" }
    return $best
}
# cach 2: bam mui ten spinbox o hop thoai Haigh de duyet qua cac node co ket qua
proc ::hx_nodes_from_spinbox {} {
    set si .resultHaighDiagramDialog.childsite.nodeSelector.si01
    set e $si.entry
    set fns {}
    ::catch {set fns [$si info function]}
    ::hx_log "discovery: spinbox functions: $fns"
    set cands {}
    foreach f $fns {
        set short [::lindex [::split $f ":"] end]
        if {[::regexp -nocase {^(up|down|next|prev|spinup|spindown|increment|decrement|stepup|stepdown|inc|dec)$} $short]} {
            lappend cands $short
        }
    }
    set start ""
    ::catch {set start [$e get]}
    ::hx_log "discovery: node hien tai=$start, ham tang=$cands"
    foreach m $cands {
        if {![::regexp -nocase {up|next|inc} $m]} continue
        set res {}
        lappend res $start
        set seen [list $start]
        set prev $start
        set plus1 0
        for {set i 0} {$i < $::hx_max_nodes} {incr i} {
            if {[::catch {$si $m} msg]} { ::hx_log "discovery: $m loi: $msg"; break }
            ::update
            ::after 250
            ::update
            set cur ""
            ::catch {set cur [$e get]}
            if {$cur eq "" || [::lsearch -exact $seen $cur] >= 0} break
            if {[::string is integer -strict $cur] && [::string is integer -strict $prev] && $cur == $prev + 1} {
                incr plus1
                if {$plus1 >= 3} { ::hx_log "discovery: $m chi tang +1, khong phai danh sach node"; set res {}; break }
            } else { set plus1 0 }
            lappend res $cur
            lappend seen $cur
            set prev $cur
        }
        if {[::llength $res] > 1} {
            ::hx_log "discovery: duyet bang $m duoc [::llength $res] node"
            return $res
        }
    }
    return {}
}
proc ::hx_discover {} {
    if {[::llength $::hx_nodes_manual] > 0} {
        ::hx_log "discovery: dung danh sach thu cong"
        return $::hx_nodes_manual
    }
    set n [::hx_nodes_from_vars]
    if {[::llength $n] > 0} { return $n }
    set n [::hx_nodes_from_spinbox]
    return $n
}

# ---------- ket thuc / chay ----------
proc ::hx_finish {} {
    set rc [::catch {.resultHaighDiagramDialog.frButtons.close invoke} msg]
    ::hx_log "close invoke rc=$rc msg=$msg"
    if {$rc} { ::catch {.resultHaighDiagramDialog.frButtons.ok invoke} }
    ::hx_log "done"
    ::catch {::close $::hx_fh}
    set ::hx_fh ""
}
proc ::hx_run {} {
    set d .resultHaighDiagramDialog
    set g $d.childsite.lf1.graph.graph
    set ns $d.childsite.nodeSelector
    if {![::winfo exists $g] || ![::winfo ismapped $g]} {
        incr ::hx_tries
        ::hx_log "graph chua hien (lan $::hx_tries)"
        if {$::hx_tries < 20} { ::after 500 ::hx_run; return }
        ::hx_log "FATAL\thop thoai Haigh khong mo duoc (da nap fps va dang o Visualization chua?)"
        ::hx_finish
        return
    }
    ::hx_log "dialog is up"
    ::catch {$ns.rbs2.rb2 invoke}
    ::update
    set ::hx_nodes [::hx_discover]
    ::hx_log "NODE LIST ([::llength $::hx_nodes]): $::hx_nodes"
    if {[::llength $::hx_nodes] == 0} {
        ::hx_log "FATAL\tkhong lay duoc danh sach node: dien tay vao ::hx_nodes_manual dau file ffj"
        ::hx_finish
        return
    }
    foreach node $::hx_nodes {
        if {[::catch {::hx_one $node} err]} {
            ::hx_log "RESULT\t$node\tFAIL\t-\t-\t$err"
        }
    }
    ::hx_finish
}
proc ::hx_start {} {
    if {![::winfo exists $::hx_btn]} {
        incr ::hx_wait
        if {$::hx_wait < 60} { ::after 500 ::hx_start; return }
        ::hx_log "FATAL\tkhong thay nut Haigh (hay vao Visualization sau khi nap fps)"
        ::catch {::close $::hx_fh}
        return
    }
    ::after 1500 ::hx_run
    set rc [::catch {$::hx_btn invoke} msg]
    ::hx_log "btHaigh invoke rc=$rc msg=$msg"
}
# tim duong dan file fps: getValue, neu khong duoc thi quet bien doc0 co gia tri la file .fps
proc ::hx_find_fps {} {
    set fps ""
    ::catch {set fps [::doc0 getValue PermanentScratchImportFile]}
    if {[::string match -nocase "*.fps" $fps]} { return $fps }
    set names {}
    ::catch {set names [::doc0 info variable]}
    foreach v $names {
        if {[::catch {::doc0 info variable $v -value} val]} continue
        if {[::string length $val] < 400 && [::string match -nocase "*.fps" $val] && [::file exists $val]} { return $val }
    }
    return ""
}
proc ::hx_main {} {
    set fps [::hx_find_fps]
    set fdir ""
    if {$fps ne ""} {
        set fdir [::file dirname $fps]
        set ::hx_prefix [::regsub -all {[^A-Za-z0-9_.-]+} [::file rootname [::file tail $fps]] "_"]
    }
    # thu tu: thu muc tu chon -> <thu muc fps>/out -> <thu muc hien tai>/out -> fallback
    set cands {}
    if {$::hx_dir_override ne ""} { lappend cands $::hx_dir_override }
    if {$fdir ne ""} { lappend cands [::file join $fdir out] }
    lappend cands [::file join [::pwd] out] $::hx_dir_fallback
    set ::hx_dir ""
    foreach c $cands {
        if {![::catch {::file mkdir $c}] && [::file isdirectory $c] && [::file writable $c]} { set ::hx_dir $c; break }
    }
    if {$::hx_dir eq ""} { return }
    set ::hx_fh [::open [::file join $::hx_dir hx_log.txt] w]
    ::hx_log "fps=$fps  out=$::hx_dir  prefix=$::hx_prefix"
    ::hx_start
}
::after 500 ::hx_main
}
