# ======================================================================
# haigh_export_all.ffj  --  FEMFAT 2024.1: xuat anh Local Haigh Diagram (full winop)
# (Popup xac nhan bang tieng Anh se hien truoc khi chay.)
# CACH DUNG: mo FEMFAT -> vao Output module -> nap fps -> (vao trang Visualization)
#            -> File > Append... -> chon file nay. Khong can thao tac gi them.
# Quy tac co dinh: Critical Point (cham do) luon BAT; luon xuat anh FULL (winop).
# Danh sach node: doc tu file .ffj nam CUNG THU MUC voi fps (neu thieu se hien popup huong dan);
# hoac dien tay vao ::hx_nodes_manual.
# ======================================================================
::uplevel #0 {
# ---------------- TUY CHON (co the sua) ----------------
set ::hx_nodes_manual {}       ;# de trong = tu lay tu fps; hoac dien tay vi du {1397615 1205731}
set ::hx_dir_override ""       ;# de trong = tao thu muc "out" canh file fps
set ::hx_dir_fallback "D:/femfat_probe/haigh_out"
set ::hx_max_nodes 500         ;# gioi han an toan khi duyet node
# ---------------- co dinh theo quy tac ----------------
set ::hx_crit_highlight 1       ;# 1 = luon bat Critical Point (theo quy tac)
set ::hx_hide_when_off 0
set ::hx_do_graph 0
set ::hx_do_full 1
set ::hx_tries 0
set ::hx_fh ""
set ::hx_prefix "haigh"
set ::hx_dir ""
set ::hx_nodes {}
set ::hx_btn ".femfat.hpane.rpane.main_sw.cv.dialogFr.bas-vi.inf.lf1.btHaigh.button"
set ::hx_wait 0

proc ::hx_log {s} { if {$::hx_fh ne ""} { ::catch {::puts $::hx_fh $s; ::flush $::hx_fh} } }

# ---------- chup anh ----------
proc ::hx_snap_graph {file} {
    ::catch {::image delete hx_img1}
    ::image create photo hx_img1
    .resultHaighDiagramDialog.childsite.lf1.graph.graph snap hx_img1
    hx_img1 write $file -format png
    ::image delete hx_img1
}
proc ::hx_snap_full {file} {
    if {[::info commands ::blt::winop] eq ""} { error "khong co ::blt::winop" }
    ::catch {::image delete hx_img3}
    ::image create photo hx_img3
    ::blt::winop snap .resultHaighDiagramDialog.childsite hx_img3
    hx_img3 write $file -format png
    ::image delete hx_img3
}

# ---------- legend / Critical Point ----------
proc ::hx_legend_text {} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    set txt ""
    foreach lb {lb1 lb2 lb3 lb4} { ::catch {append txt " | [$cv.$lb cget -text]"} }
    return $txt
}
proc ::hx_wait_legend {pat {maxms 5000}} {
    set t 0
    while {$t <= $maxms} {
        ::update
        if {[::string first $pat [::hx_legend_text]] >= 0} { return 1 }
        ::after 100
        incr t 100
    }
    return 0
}
proc ::hx_crit_row {} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    foreach i {1 2 3 4} {
        if {[::catch {$cv.lb$i cget -text} t]} continue
        if {[::string match -nocase "*critical*" $t]} { return $i }
    }
    return 0
}
proc ::hx_crit_on {k} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    if {[::catch {
        set a [$cv.lb$k cget -background]
        set b [$cv cget -background]
    }]} { return 0 }
    return [expr {$a ne $b}]
}
proc ::hx_click {w} {
    ::catch {::event generate $w <Enter>}
    ::event generate $w <ButtonPress-1> -x 3 -y 3
    ::event generate $w <ButtonRelease-1> -x 3 -y 3
    ::update
}
proc ::hx_set_crit {want} {
    set d .resultHaighDiagramDialog.childsite.lf1.legend
    set k [::hx_crit_row]
    if {$k == 0} { ::hx_log "crit: khong thay hang 'Critical' trong legend"; return 0 }
    set cur [::hx_crit_on $k]
    ::hx_log "crit: row=$k highlighted=$cur want=$want"
    if {$cur == $want} { return 1 }
    foreach w [list $d.cv.lb$k $d.cv.leg$k] {
        ::catch {::hx_click $w} msg
        if {[::hx_crit_on $k] == $want} { ::hx_log "crit: doi trang thai bang click vao $w"; return 1 }
    }
    foreach arg [list {} $k] {
        set rc [::catch {$d toggleHighlightGraph {*}$arg} msg]
        ::update
        ::hx_log "crit: toggleHighlightGraph {$arg} rc=$rc msg=$msg now=[::hx_crit_on $k]"
        if {$rc == 0 && [::hx_crit_on $k] == $want} { return 1 }
    }
    return 0
}




proc ::hx_dump_legend {} {
    set cv .resultHaighDiagramDialog.childsite.lf1.legend.cv
    ::catch {::hx_log "legend cv bg=[$cv cget -background]"}
    foreach i {1 2 3 4} {
        set line "legend row $i:"
        ::catch {append line " text='[$cv.lb$i cget -text]' lb_bg=[$cv.lb$i cget -background]"}
        ::catch {append line " leg_bg=[$cv.leg$i cget -background]"}
        ::hx_log $line
    }
}
proc ::hx_crit_elements {} {
    set g .resultHaighDiagramDialog.childsite.lf1.graph.graph
    set res {}
    foreach el [$g element names] {
        if {[::catch {$g element cget $el -label} lab]} continue
        if {[::string match -nocase "*critical*" $lab]} { lappend res $el }
    }
    return $res
}
proc ::hx_dump_elements {tag} {
    set g .resultHaighDiagramDialog.childsite.lf1.graph.graph
    foreach el [$g element names] {
        set line "element($tag) $el:"
        foreach opt {-label -pixels -symbol -fill -color -hide -scalesymbols} {
            ::catch {append line " $opt=[$g element cget $el $opt]"}
        }
        ::hx_log $line
    }
}
proc ::hx_force_big {} {
    set g .resultHaighDiagramDialog.childsite.lf1.graph.graph
    foreach el [$g element names] {
        if {[::catch {$g element cget $el -label} lab]} continue
        if {![::string match -nocase "*critical*" $lab]} continue
        set rc [::catch {
            set px [$g element cget $el -pixels]
            $g element configure $el -pixels [expr {$px < 14 ? 14 : $px}]
        } msg]
        ::hx_log "force big: element $el label=$lab rc=$rc msg=$msg"
    }
}
proc ::hx_apply_crit {} {
    if {$::hx_crit_highlight < 0} { return }
    set ok [::hx_set_crit $::hx_crit_highlight]
    if {!$ok && $::hx_crit_highlight == 1} {
        ::hx_log "crit: khong bat duoc bang GUI -> dung cach du phong (phong to ky hieu)"
        ::hx_force_big
    }
    ::update
}

# ---------- tung node ----------
proc ::hx_one {node} {
    set d .resultHaighDiagramDialog
    set si $d.childsite.nodeSelector.si01
    ::hx_log "---- node $node ----"
    ::catch {$si.entry delete 0 end}
    ::catch {$si.entry insert 0 $node}
    set rc [::catch {$si apply} msg]
    ::hx_log "spinbox apply rc=$rc msg=$msg"
    if {![::hx_wait_legend "N$node" 6000]} {
        ::hx_log "RESULT\t$node\tFAIL\t-\t-\tnode khong co trong DETAILED RESULTS hoac do thi khong doi"
        return
    }
    if {![::info exists ::hx_dumped]} { ::catch {::hx_dump_legend}; ::hx_dump_elements truoc; set ::hx_dumped 1 }
    ::hx_apply_crit
    ::catch {::hx_dump_legend}
    ::hx_dump_elements sau
    ::update
    ::catch {::raise $d}
    ::update
    set gfile "-"
    set ffile "-"
    set err ""
    if {$::hx_do_graph} {
        set f [::file join $::hx_dir "${::hx_prefix}_N${node}_graph.png"]
        if {[::catch {::hx_snap_graph $f} msg]} { append err " graph:$msg" } else { set gfile $f }
    }
    if {$::hx_do_full} {
        set f [::file join $::hx_dir "${::hx_prefix}_N${node}_full.png"]
        if {[::catch {::hx_snap_full $f} msg]} { append err " full:$msg" } else { set ffile $f }
    }
    if {$err eq ""} {
        ::hx_log "RESULT\t$node\tOK\t$gfile\t$ffile\t"
    } else {
        ::hx_log "RESULT\t$node\tFAIL\t$gfile\t$ffile\t[::string trim $err]"
    }
}


# ---------- lay danh sach node tu fps ----------
# cac so 5-9 chu so (node ID) trong mot chuoi
proc ::hx_num_tokens {val} {
    set out {}
    foreach t [::regexp -all -inline {[0-9]{5,9}} $val] {
        if {[::lsearch -exact $out $t] < 0} { lappend out $t }
    }
    return $out
}
# cach 1: quet moi bien cua mot doi tuong Itcl, lay bien chua danh sach node dai nhat
proc ::hx_scan_obj {obj minCount} {
    set best {}
    set names {}
    ::catch {set names [$obj info variable]}
    ::hx_log "discovery: quet $obj ([::llength $names] bien)"
    foreach v $names {
        if {[::catch {$obj info variable $v -value} val]} continue
        if {[::string length $val] > 300000} continue
        set nums [::hx_num_tokens $val]
        if {[::llength $nums] >= $minCount} {
            ::hx_log "discovery:   $v -> [::llength $nums] so, dau: [::lrange $nums 0 5]"
            if {[::llength $nums] > [::llength $best]} { set best $nums }
        }
    }
    return $best
}
proc ::hx_entry_val {si} {
    set v ""
    ::catch {set v [$si.entry get]}
    return [::string trim $v]
}
# buoc spinbox 1 lan bang ham m (incrCmd/decrCmd), tra ve gia tri o nhap sau do
proc ::hx_step {si m} {
    set rc [::catch {$si $m} msg]
    if {$rc} {
        set rc [::catch {$si $m 1} msg2]
        if {$rc} { ::hx_log "discovery: $m loi: $msg | $msg2"; return "" }
    }
    ::update
    ::after 300
    ::update
    return [::hx_entry_val $si]
}
# cach 2: duyet lien tiep bang incrCmd/decrCmd cua spinbox: xuong den dau danh sach, roi len het
proc ::hx_nodes_from_spinbox {} {
    set si .resultHaighDiagramDialog.childsite.nodeSelector.si01
    set start [::hx_entry_val $si]
    foreach m {incrCmd decrCmd} {
        ::catch {::hx_log "discovery: $m args = [$si info function ::Femfat::SpinBox::$m -args]"}
    }
    ::hx_log "discovery: node hien tai=$start"
    # pha 1: di xuong
    set seen [list $start]
    set prev $start
    set plus1 0
    set low $start
    for {set i 0} {$i < $::hx_max_nodes} {incr i} {
        set cur [::hx_step $si decrCmd]
        if {$cur eq "" || [::lsearch -exact $seen $cur] >= 0} break
        if {[::string is integer -strict $cur] && [::string is integer -strict $prev] && $cur == $prev - 1} {
            incr plus1
            if {$plus1 >= 3} { ::hx_log "discovery: decrCmd chi giam 1 moi lan, khong phai duyet danh sach node"; return {} }
        } else { set plus1 0 }
        lappend seen $cur
        set prev $cur
        set low $cur
    }
    ::hx_log "discovery: dau danh sach (thap nhat) = $low"
    # quay ve diem thap nhat roi di len
    set res [list $low]
    set seenU [list $low]
    set prev $low
    ::catch {$si.entry delete 0 end; $si.entry insert 0 $low; $si apply}
    ::update
    for {set i 0} {$i < $::hx_max_nodes} {incr i} {
        set cur [::hx_step $si incrCmd]
        if {$cur eq "" || [::lsearch -exact $seenU $cur] >= 0} break
        lappend res $cur
        lappend seenU $cur
    }
    ::hx_log "discovery: duyet duoc [::llength $res] node bang spinbox"
    return $res
}
proc ::hx_discover {} {
    if {[::llength $::hx_nodes_manual] > 0} {
        ::hx_log "discovery: dung danh sach thu cong"
        return $::hx_nodes_manual
    }
    set d .resultHaighDiagramDialog
    set names {}
    ::catch {set names [::doc0 info variable]}
    set short {}
    foreach v $names { lappend short [::lindex [::split $v :] end] }
    ::hx_log "discovery: bien doc0: $short"
    # 1a) doi tuong hop thoai Haigh / o chon node
    foreach obj [list $d.childsite.nodeSelector.si01 $d.childsite.nodeSelector $d] {
        set n [::hx_scan_obj $obj 2]
        if {[::llength $n] > 0} { ::hx_log "discovery: chon danh sach tu $obj"; return $n }
    }
    # 1b) duyet bang spinbox
    set n [::hx_nodes_from_spinbox]
    if {[::llength $n] > 0} { return $n }
    # 1c) cuoi cung: quet doc0
    set n [::hx_scan_obj ::doc0 3]
    return $n
}

# ---------- ket thuc / chay ----------
proc ::hx_finish {} {
    set rc [::catch {.resultHaighDiagramDialog.frButtons.close invoke} msg]
    ::hx_log "close invoke rc=$rc msg=$msg"
    if {$rc} { ::catch {.resultHaighDiagramDialog.frButtons.ok invoke} }
    ::hx_log "done"
    ::catch {::close $::hx_fh}
    set ::hx_fh ""
}
proc ::hx_run {} {
    set d .resultHaighDiagramDialog
    set g $d.childsite.lf1.graph.graph
    set ns $d.childsite.nodeSelector
    if {![::winfo exists $g] || ![::winfo ismapped $g]} {
        incr ::hx_tries
        ::hx_log "graph chua hien (lan $::hx_tries)"
        if {$::hx_tries < 20} { ::after 500 ::hx_run; return }
        ::hx_log "FATAL\thop thoai Haigh khong mo duoc (da nap fps va dang o Visualization chua?)"
        ::hx_finish
        return
    }
    ::hx_log "dialog is up"
    ::catch {$ns.rbs2.rb2 invoke}
    ::update
    if {[::llength $::hx_nodes] == 0} { set ::hx_nodes [::hx_discover] }
    ::hx_log "NODE LIST ([::llength $::hx_nodes]): $::hx_nodes"
    if {[::llength $::hx_nodes] == 0} {
        ::hx_log "FATAL\tkhong lay duoc danh sach node: dien tay vao ::hx_nodes_manual dau file ffj"
        ::hx_finish
        return
    }
    foreach node $::hx_nodes {
        if {[::catch {::hx_one $node} err]} {
            ::hx_log "RESULT\t$node\tFAIL\t-\t-\t$err"
        }
    }
    ::hx_finish
}
proc ::hx_start {} {
    if {![::winfo exists $::hx_btn]} {
        incr ::hx_wait
        if {$::hx_wait < 60} { ::after 500 ::hx_start; return }
        ::hx_log "FATAL\tkhong thay nut Haigh (hay vao Visualization sau khi nap fps)"
        ::catch {::close $::hx_fh}
        return
    }
    ::after 1500 ::hx_run
    set rc [::catch {$::hx_btn invoke} msg]
    ::hx_log "btHaigh invoke rc=$rc msg=$msg"
}
# tim duong dan file fps: getValue, neu khong duoc thi quet bien doc0 co gia tri la file .fps
proc ::hx_find_fps {} {
    set fps ""
    ::catch {set fps [::doc0 getValue PermanentScratchImportFile]}
    if {[::string match -nocase "*.fps" $fps]} { return $fps }
    set names {}
    ::catch {set names [::doc0 info variable]}
    foreach v $names {
        if {[::catch {::doc0 info variable $v -value} val]} continue
        if {[::string length $val] < 400 && [::string match -nocase "*.fps" $val] && [::file exists $val]} { return $val }
    }
    return ""
}
# ---------- doc node tu file ffj nam cung thu muc voi fps ----------
# Dinh dang ffj cua FEMFAT: GUI_Group:NodeLabelFrom/To <node> ... GUI_Group:Add (them vao nhom dang chon).
# Chi lay node duoc them khi nhom hien tai la "DETAILED RESULTS"; lenh GUI_Group:DetailedResultGroup
# cung tinh la them cap From/To dang cho vao nhom nay. Nhom khac (vi du Dummy) bi bo qua.
proc ::hx_nodes_in_ffj {file} {
    if {[::catch {set fh [::open $file r]; set txt [::read $fh]; ::close $fh}]} { return {} }
    set res {}
    set grp ""
    set from ""
    set to ""
    set anyAll {}
    foreach line [::split $txt "\n"] {
        set l [::string trim $line]
        if {$l eq "" || [::string index $l 0] eq "#"} continue
        if {[::regexp {GUI_Group:NodeLabelFrom[ \t]+([0-9]+)} $l -> v]} { set from $v; if {[::lsearch -exact $anyAll $v] < 0} { lappend anyAll $v }; continue }
        if {[::regexp {GUI_Group:NodeLabelTo[ \t]+([0-9]+)} $l -> v]} { set to $v; if {[::lsearch -exact $anyAll $v] < 0} { lappend anyAll $v }; continue }
        set add 0
        if {[::string first "GUI_Group:Group " $l] >= 0} {
            set grp $l
        } elseif {[::string match "*GUI_Group:DetailedResultGroup" $l]} {
            set grp "DETAILED"
            set add 1
        } elseif {[::string match "*GUI_Group:Add" $l]} {
            set add 1
        }
        if {$add && [::string match -nocase "*DETAILED*" $grp]} {
            foreach v [list $from $to] {
                if {$v ne "" && [::lsearch -exact $res $v] < 0} { lappend res $v }
            }
        }
    }
    if {[::llength $res] > 0} { return $res }
    return $anyAll
}
# tim ffj canh fps: uu tien cung ten voi fps, sau do cac ffj khac (bo qua file script cua chinh minh)
proc ::hx_find_ffj_nodes {fdir stem} {
    set cands {}
    set same [::file join $fdir "$stem.ffj"]
    if {[::file exists $same]} { lappend cands $same }
    foreach f [::lsort [::glob -nocomplain -directory $fdir *.ffj]] {
        set tail [::file tail $f]
        if {[::string match -nocase "haigh_export*" $tail] || [::string match -nocase "run_haigh*" $tail]} continue
        if {[::lsearch -exact $cands $f] < 0} { lappend cands $f }
    }
    ::hx_log "ffj ung vien: $cands"
    foreach f $cands {
        set n [::hx_nodes_in_ffj $f]
        if {[::llength $n] > 0} {
            ::hx_log "node lay tu ffj: $f ([::llength $n] node)"
            return $n
        }
    }
    return {}
}
proc ::hx_popup_missing {kind fdir stem} {
    if {$kind eq "nofps"} {
        set msg "Could not determine which fps file is loaded.\n\nLoad the fps file in the Output module first, then run File > Append > haigh_export_all.ffj again."
    } else {
        set msg "No ffj file containing the node list was found.\n\nPlease copy the .ffj file (with the node IDs to export) into the SAME FOLDER as the fps file:\n$fdir\n\nRecommended name: $stem.ffj\n\nThen run File > Append > haigh_export_all.ffj again."
    }
    ::catch {::tk_messageBox -icon warning -type ok -title "Haigh Export - ffj file missing" -message $msg}
}
proc ::hx_main {} {
    set fps [::hx_find_fps]
    set fdir ""
    if {$fps ne ""} {
        set fdir [::file dirname $fps]
        set ::hx_prefix [::regsub -all {[^A-Za-z0-9_.-]+} [::file rootname [::file tail $fps]] "_"]
    }
    # thu tu: thu muc tu chon -> <thu muc fps>/out -> <thu muc hien tai>/out -> fallback
    set cands {}
    if {$::hx_dir_override ne ""} { lappend cands $::hx_dir_override }
    if {$fdir ne ""} { lappend cands [::file join $fdir out] }
    lappend cands [::file join [::pwd] out] $::hx_dir_fallback
    set ::hx_dir ""
    foreach c $cands {
        if {![::catch {::file mkdir $c}] && [::file isdirectory $c] && [::file writable $c]} { set ::hx_dir $c; break }
    }
    if {$::hx_dir eq ""} { return }
    set ::hx_fh [::open [::file join $::hx_dir hx_log.txt] w]
    ::hx_log "fps=$fps  out=$::hx_dir  prefix=$::hx_prefix"
    # ---- confirmation popup (English) ----
    if {$fps ne ""} {
        set stem0 [::file rootname [::file tail $fps]]
        set pre [::hx_find_ffj_nodes $fdir $stem0]
        if {[::llength $pre] > 0} {
            set st1 "FOUND ([::llength $pre] node IDs detected)"
        } else {
            set st1 "NOT FOUND - please copy the ffj file into: $fdir"
        }
    } else {
        set st1 "UNKNOWN - fps file not detected"
    }
    set cmsg "Please confirm before the export starts:\n\n"
    append cmsg "1. Is the ffj file (with the node IDs) in the SAME FOLDER as the fps file?\n"
    append cmsg "     Automatic check: $st1\n\n"
    append cmsg "2. Have you already opened a Haigh diagram and turned ON the Critical Point (red dot) option?\n"
    append cmsg "     (FEMFAT remembers this setting; the script relies on it.)\n\n"
    append cmsg "Click OK to start the export, or Cancel to stop."
    set ans [::tk_messageBox -icon question -type okcancel -default ok -title "Haigh Export - confirm" -message $cmsg]
    if {$ans ne "ok"} {
        ::hx_log "Cancelled by user at confirmation popup"
        ::catch {::close $::hx_fh}
        return
    }
    if {[::llength $::hx_nodes_manual] > 0} {
        set ::hx_nodes $::hx_nodes_manual
    } elseif {$fps eq ""} {
        ::hx_log "FATAL\tkhong xac dinh duoc file fps"
        ::hx_popup_missing nofps "" ""
        ::catch {::close $::hx_fh}
        return
    } else {
        set stem [::file rootname [::file tail $fps]]
        set ::hx_nodes [::hx_find_ffj_nodes $fdir $stem]
        if {[::llength $::hx_nodes] == 0} {
            ::hx_log "FATAL\tkhong co ffj chua node ID canh fps: $fdir"
            ::hx_popup_missing noffj $fdir $stem
            ::catch {::close $::hx_fh}
            return
        }
    }
    ::hx_log "NODE LIST tu ffj ([::llength $::hx_nodes]): $::hx_nodes"
    ::hx_start
}
::after 500 ::hx_main
}
