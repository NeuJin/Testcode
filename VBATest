Sub Check()
    Dim wsMain As Worksheet: Set wsMain = ActiveSheet
    Dim wbReq As Workbook, wsReq As Worksheet, wbSam As Workbook, wsSam As Worksheet
    Dim reqPath As String, samPath As String, sheetName As String
    Dim r As Long, outRow As Long, k As String, matchedRow As Long
    Dim dictReq As Object: Set dictReq = CreateObject("Scripting.Dictionary")
    Dim dictSam As Object: Set dictSam = CreateObject("Scripting.Dictionary")
    Dim dictMatchedReqRows As Object: Set dictMatchedReqRows = CreateObject("Scripting.Dictionary")
    Dim specCols As Collection
    Dim sCol As Long, rCol As Long

    reqPath = Trim(wsMain.Range("D2").Value): samPath = Trim(wsMain.Range("D3").Value)
    sheetName = Trim(wsMain.Range("M8").Value)
    sCol = ColLetterToNum(wsMain.Range("O8").Value) ' Target column in Sample
    rCol = ColLetterToNum(wsMain.Range("P8").Value) ' Target column in Request

    Application.ScreenUpdating = False: Application.DisplayAlerts = False

    ' --- Extract Task Info (No. / 件名 / 機種名) from D1 ---
    Dim taskInfoPath As String, wbTask As Workbook, wsTask As Worksheet

    taskInfoPath = Trim(wsMain.Range("D1").Value)

    If taskInfoPath = "" Then
        Application.DisplayAlerts = True: Application.ScreenUpdating = True
        MsgBox "Cell D1 (Task info) đang trống!", vbCritical
        Exit Sub
    End If

    On Error Resume Next
    Set wbTask = Workbooks.Open(taskInfoPath, 0, True)
    On Error GoTo 0

    If wbTask Is Nothing Then
        Application.DisplayAlerts = True: Application.ScreenUpdating = True
        MsgBox "Không mở được file Task Info: " & taskInfoPath, vbCritical
        Exit Sub
    End If

    Set wsTask = wbTask.Sheets("パワートレイン構造解析")
    wsMain.Range("P1").Value = Trim(wsTask.Range("D2").Value) ' No.
    wsMain.Range("P2").Value = Trim(wsTask.Range("D3").Value) ' 件名
    wsMain.Range("P3").Value = Trim(wsTask.Range("D4").Value) ' 機種名
    wbTask.Close False

    Set specCols = GetSpecColCollection(wsMain)
    Debug.Print "specCols.Count = " & specCols.Count   ' <-- DEBUG

    ' --- Load Sample ---
    Set wbSam = Workbooks.Open(samPath, 0, True): Set wsSam = wbSam.Sheets(sheetName)
    Call UnmergeAndFill(wsSam, FindHeaderRow(wsSam), wsSam.UsedRange.Rows.Count, specCols)
    For r = FindHeaderRow(wsSam) To wsSam.UsedRange.Rows.Count
        k = CreateKey(wsSam, r, specCols)
        If k <> "" Then
            If Not dictSam.exists(k) Then Set dictSam(k) = New Collection
            dictSam(k).Add r
        End If
    Next r
    Debug.Print "dictSam.Count = " & dictSam.Count      ' <-- DEBUG

    ' --- Load Request ---
    Set wbReq = Workbooks.Open(reqPath, 0, True): Set wsReq = wbReq.Sheets(sheetName)
    Call UnmergeAndFill(wsReq, FindHeaderRow(wsReq), wsReq.UsedRange.Rows.Count, specCols)
    For r = FindHeaderRow(wsReq) To wsReq.UsedRange.Rows.Count
        k = CreateKey(wsReq, r, specCols)
        If k <> "" Then
            If Not dictReq.exists(k) Then Set dictReq(k) = New Collection
            dictReq(k).Add r
        End If
    Next r
    Debug.Print "dictReq.Count = " & dictReq.Count       ' <-- DEBUG

    ' --- Compare ---
    outRow = 9
    Debug.Print "wsMain key row9 = [" & CreateKey(wsMain, 9, specCols) & "]"   ' <-- DEBUG
    Do While wsMain.Cells(outRow, "C").Value <> ""
        k = CreateKey(wsMain, outRow, specCols)
        wsMain.Cells(outRow, "N").ClearContents: wsMain.Cells(outRow, "N").Interior.ColorIndex = xlNone
        wsMain.Cells(outRow, "O").ClearContents: wsMain.Cells(outRow, "P").ClearContents
        wsMain.Cells(outRow, "P").Font.ColorIndex = xlAutomatic: wsMain.Cells(outRow, "P").Font.Bold = False

        ' Pull Sample (With Arrow Check)
        If dictSam.exists(k) Then
            If dictSam(k).Count > 0 Then
                wsMain.Cells(outRow, "O").Value = GetValueWithArrowCheck(wsSam, CLng(dictSam(k)(1)), sCol)
                dictSam(k).Remove 1
            End If
        End If

        ' Pull Request (With Arrow Check)
        If dictReq.exists(k) Then
            If dictReq(k).Count > 0 Then
                matchedRow = dictReq(k)(1)
                dictMatchedReqRows(matchedRow) = True
                wsMain.Cells(outRow, "N").Value = "O": wsMain.Cells(outRow, "N").Interior.Color = RGB(200, 255, 200)
                wsMain.Cells(outRow, "P").Value = GetValueWithArrowCheck(wsReq, matchedRow, rCol)
                dictReq(k).Remove 1

                If Trim(CStr(wsMain.Cells(outRow, "O").Value)) <> Trim(CStr(wsMain.Cells(outRow, "P").Value)) Then
                    wsMain.Cells(outRow, "P").Font.Color = RGB(255, 0, 0): wsMain.Cells(outRow, "P").Font.Bold = True
                End If
            End If
        Else
            wsMain.Cells(outRow, "N").Value = "X": wsMain.Cells(outRow, "N").Interior.Color = RGB(255, 200, 200)
        End If
        outRow = outRow + 1
    Loop

    wbSam.Close False: wbReq.Close False
    Application.DisplayAlerts = True: Application.ScreenUpdating = True
    MsgBox "Check completed!", vbInformation
End Sub
