Sub UpdatePPTTable(ws As Worksheet, slIdx As Integer, tblName As String, rngAddr As String, pres As Object)
    Dim srcRng As Range, pptTbl As Object, r As Long, c As Long, currentCell As Range

    On Error GoTo ErrHandler

    Set srcRng = ws.Range(rngAddr)
    Set pptTbl = pres.Slides(slIdx).Shapes(tblName).Table

    If srcRng Is Nothing Or pptTbl Is Nothing Then Exit Sub

    For r = 1 To srcRng.Rows.Count
        For c = 1 To srcRng.Columns.Count
            If r <= pptTbl.Rows.Count And c <= pptTbl.Columns.Count Then
                Set currentCell = srcRng.Cells(r, c)
                pptTbl.Cell(r, c).Shape.TextFrame.TextRange.Text = IIf(currentCell.MergeCells, currentCell.MergeArea.Cells(1, 1).Text, currentCell.Text)
            End If
        Next c
    Next r
    Exit Sub

ErrHandler:
    MsgBox "Lỗi khi cập nhật bảng: " & tblName & vbCrLf & _
           "Slide Index: " & slIdx & vbCrLf & _
           "Excel Range: " & rngAddr & vbCrLf & _
           "Error " & Err.Number & ": " & Err.Description, _
           vbExclamation, "UpdatePPTTable - Lỗi"
End Sub
